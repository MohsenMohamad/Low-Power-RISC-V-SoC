[tasks]
prove
cover

[options]
multiclock on
prove: mode prove
cover: mode cover
cover: depth 40

[engines]
prove: abc pdr
cover: smtbmc z3

[script]
read_verilog -sv -formal -I. tech_sync.sv tech_clk_gate.sv tech_clk_or.sv rst_sync.sv
read_verilog -sv -formal -DFORMAL_MULTICLOCK -I. dvfs_clk_mux.sv
read_verilog -sv -formal -I. dvfs_mux_formal.sv
prep -top dvfs_mux_formal

[files]
../rtl/include/sva_macros.svh
../rtl/tech/tech_sync.sv
../rtl/tech/tech_clk_gate.sv
../rtl/tech/tech_clk_or.sv
../rtl/common/rst_sync.sv
../rtl/clk/dvfs_clk_mux.sv
dvfs_mux_formal.sv
